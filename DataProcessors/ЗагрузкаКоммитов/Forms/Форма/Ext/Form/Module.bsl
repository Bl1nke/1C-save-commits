// ===================== Загрузка коммитов (предпросмотр) =====================

&НаКлиенте
Процедура ЗагрузитьКоммиты(Команда)
    Попытка
        ЗагрузитьКоммитыНаСервере();
        Сообщить("✅ Коммиты загружены в таблицу. Проверьте и нажмите ""Сохранить новые коммиты"".");
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКоммитыНаСервере()
    
    ПутьКGit = "C:\Program Files\Git\bin\git.exe";
    URLРепозитория = "https://github.com/Bl1nke/save-logs.git";
    
    Если ПустаяСтрока(Объект.ПутьКРепозиторию) Тогда
        Сообщить("❌ Не указан путь к локальной папке репозитория");
        Возврат;
    КонецЕсли;
    
    Если ПустаяСтрока(Объект.ИмяВетки) Тогда
        Сообщить("❌ Не указано имя ветки");
        Возврат;
    КонецЕсли;
    
    Если НЕ ФайлСуществует(ПутьКGit) Тогда
        Сообщить("❌ Git не найден по пути: " + ПутьКGit);
        Возврат;
    КонецЕсли;
    
    Если НЕ ФайлСуществует(Объект.ПутьКРепозиторию + "\.git") Тогда
        
        СоздатьРодительскиеПапки(Объект.ПутьКРепозиторию);
        Сообщить("Клонирование репозитория, это может занять время...");
        ВыполнитьGitКоманду(ПутьКGit, "clone """ + URLРепозитория + """ """ + Объект.ПутьКРепозиторию + """", "C:\temp");
        
        Если НЕ ФайлСуществует(Объект.ПутьКРепозиторию + "\.git") Тогда
            Сообщить("❌ Клонирование не удалось. Проверьте путь и доступ к интернету.");
            Возврат;
        КонецЕсли;
        
    КонецЕсли;
    
    // Забираем ВСЕ ветки и их коммиты с сервера, не только текущую
    Сообщить("Получение данных с сервера (git fetch --all)...");
    ВыполнитьGitКоманду(ПутьКGit, "fetch --all", Объект.ПутьКРепозиторию);
    
    // Переключаемся на нужную ветку (создаём локальную, если её ещё нет,
    // но remote-ветка уже подтянулась через fetch)
    Сообщить("Переключение на ветку " + Объект.ИмяВетки + "...");
    ВыполнитьGitКоманду(ПутьКGit, "checkout " + Объект.ИмяВетки, Объект.ПутьКРепозиторию);
    
    // Подтягиваем актуальное состояние именно этой ветки
    Сообщить("Обновление ветки (git pull)...");
    ВыполнитьGitКоманду(ПутьКGit, "pull", Объект.ПутьКРепозиторию);
    
    ТекстКоммитов = ПолучитьКоммиты(ПутьКGit, Объект.ПутьКРепозиторию, Объект.ИмяВетки);
    
    Если ПустаяСтрока(ТекстКоммитов) Тогда
        Сообщить("Нет коммитов");
        Возврат;
    КонецЕсли;
    
    ВеткаСсылка = НайтиИлиСоздатьВетку(Объект.ИмяВетки, URLРепозитория);
    
    Если ВеткаСсылка = Неопределено Тогда
        Сообщить("❌ Не удалось получить ссылку на ветку");
        Возврат;
    КонецЕсли;
    
    Объект.ТекущаяВетка = ВеткаСсылка;
    
    ЗаполнитьТаблицуФормы(ТекстКоммитов);
    
КонецПроцедуры
// Создаёт все промежуточные папки в пути, если их ещё нет.
// Например, для "C:\temp\myrepo" создаст сначала "C:\temp", потом "C:\temp\myrepo"
// (саму myrepo создавать не нужно — её создаст git clone).
&НаСервере
Процедура СоздатьРодительскиеПапки(Путь)
    
    Родитель = СокрЛП(Путь);
    
    // Убираем последнюю папку из пути, оставляя только родительскую
    ПозицияСлэша = 0;
    Для Индекс = СтрДлина(Родитель) По 1 Цикл
        Если Сред(Родитель, Индекс, 1) = "\" Тогда
            ПозицияСлэша = Индекс;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    
    Если ПозицияСлэша > 0 Тогда
        РодительскаяПапка = Лев(Родитель, ПозицияСлэша - 1);
        Если НЕ ФайлСуществует(РодительскаяПапка) Тогда
            СоздатьКаталог(РодительскаяПапка);
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФормы(ТекстКоммитов)
    
    РазделительЗаписей = Символ(30); // 0x1E
    РазделительПолей   = Символ(31); // 0x1F
    
    Объект.Коммиты.Очистить();
    
    Записи = СтрРазделить(ТекстКоммитов, РазделительЗаписей);
    
    Для Каждого Запись Из Записи Цикл
        Запись = СокрЛП(Запись);
        Если ПустаяСтрока(Запись) Тогда Продолжить; КонецЕсли;
        
        Поля = СтрРазделить(Запись, РазделительПолей, Ложь);
        Если Поля.Количество() < 5 Тогда Продолжить; КонецЕсли;
        
        Хэш       = СокрЛП(Поля[0]);
        Автор     = НормализоватьАвтора(СокрЛП(Поля[1]));
        Почта     = СокрЛП(Поля[2]);
        ДатаСтр   = СокрЛП(Поля[3]);
        Сообщение = СокрЛП(Поля[4]);
        
        УжеЕсть = КоммитСуществует(Хэш);
        
        НоваяСтрока = Объект.Коммиты.Добавить();
        НоваяСтрока.ХЭШ = Хэш;
        НоваяСтрока.Автор = Автор;
        НоваяСтрока.ПочтаАвтора = Почта;
        НоваяСтрока.ДатаКоммита = РаспарситьДату(ДатаСтр);
        НоваяСтрока.СобщениеКоммита = Сообщение;
        НоваяСтрока.Статус = ?(УжеЕсть, "Уже есть в базе", "Новый");
        
    КонецЦикла;
    
    Сообщить("В таблице коммитов: " + Объект.Коммиты.Количество());
    
КонецПроцедуры

&НаСервере
Функция КоммитСуществует(Хэш)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Справочник.Коммиты ГДЕ ХЭШ = &Х";
    Запрос.УстановитьПараметр("Х", Хэш);
    Возврат Запрос.Выполнить().Выгрузить()[0].К > 0;
КонецФункции

// ===================== Сохранение новых коммитов =====================

&НаКлиенте
Процедура СохранитьНовыеКоммиты(Команда)
    Попытка
        СохранитьНовыеКоммитыНаСервере();
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНовыеКоммитыНаСервере()
    
    Если Объект.Коммиты.Количество() = 0 Тогда
        Сообщить("Таблица коммитов пуста. Сначала загрузите коммиты.");
        Возврат;
    КонецЕсли;
    
    Если Объект.ТекущаяВетка.Пустая() Тогда
        Сообщить("Не определена ветка. Загрузите коммиты заново.");
        Возврат;
    КонецЕсли;
    
    Создано = 0;
    Пропущено = 0;
    
    Для Каждого Строка Из Объект.Коммиты Цикл
        
        Если КоммитСуществует(Строка.ХЭШ) Тогда
            Строка.Статус = "Уже есть в базе";
            Пропущено = Пропущено + 1;
            Продолжить;
        КонецЕсли;
        
        Попытка
            Коммит = Справочники.Коммиты.СоздатьЭлемент();
            Коммит.Наименование = Строка.ХЭШ;
            Коммит.Автор = Строка.Автор;
            Коммит.ПочтаАвтора = Строка.ПочтаАвтора;
            Коммит.ХЭШ = Строка.ХЭШ;
            Коммит.ДатаКоммита = Строка.ДатаКоммита;
            Коммит.СобщениеКоммита = Строка.СобщениеКоммита;
            Коммит.Ветка = Объект.ТекущаяВетка;
            
            // Если по-прежнему видите ошибку "поле Ветка не заполнено" —
            // раскомментируйте строку ниже (это значит, что владелец ещё не отключён):
            // Коммит.ОбменДанными.Загрузка = Истина;
            
            Коммит.Записать();
            
            Строка.Статус = "Сохранён";
            Создано = Создано + 1;
        Исключение
            Строка.Статус = "Ошибка: " + СокрЛП(ОписаниеОшибки());
            Сообщить("❌ Ошибка коммита " + Лев(Строка.ХЭШ, 8) + ": " + ОписаниеОшибки());
        КонецПопытки;
        
    КонецЦикла;
    
    Сообщить("Сохранено новых коммитов: " + Создано + ". Пропущено (уже были): " + Пропущено);
    
КонецПроцедуры

// ===================== Вспомогательные функции =====================

&НаСервере
Функция НайтиИлиСоздатьВетку(ИмяВетки, URLРепозитория)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Ветки.Ссылка
        |ИЗ
        |    Справочник.Ветки КАК Ветки
        |ГДЕ
        |    Ветки.Наименование = &ИмяВетки";
    
    Запрос.УстановитьПараметр("ИмяВетки", ИмяВетки);
    Результат = Запрос.Выполнить().Выгрузить();
    
    Если Результат.Количество() > 0 Тогда
        Возврат Результат[0].Ссылка;
    КонецЕсли;
    
    Попытка
        НоваяВетка = Справочники.Ветки.СоздатьЭлемент();
        НоваяВетка.Наименование = ИмяВетки;
        
        Если НоваяВетка.Метаданные().Реквизиты.Найти("ПутьКУдаленномуРепозиторию") <> Неопределено Тогда
            НоваяВетка.ПутьКУдаленномуРепозиторию = URLРепозитория;
        КонецЕсли;
        
        НоваяВетка.Записать();
        Возврат НоваяВетка.Ссылка;
    Исключение
        Сообщить("❌ Ошибка создания ветки: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
    
КонецФункции

&НаСервере
Функция ФайлСуществует(Путь)
    Попытка
        Файл = Новый Файл(Путь);
        Возврат Файл.Существует();
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

&НаСервере
Процедура ВыполнитьGitКоманду(ПутьКGit, Команда, Папка)
    ЗапуститьПриложение("""" + ПутьКGit + """ " + Команда, Папка, Истина, 60000);
КонецПроцедуры

&НаСервере
Функция ПолучитьКоммиты(ПутьКGit, Папка, Ветка)
    ВремФайл = ПолучитьИмяВременногоФайла("txt");
    BatФайл = ПолучитьИмяВременногоФайла("bat");
    
    ТекстBat = "@echo off" + Символы.ПС + 
               """" + ПутьКGit + """ log " + Ветка + 
               " --pretty=format:""%%H%%x1f%%an%%x1f%%ae%%x1f%%aI%%x1f%%s%%x1e""" + 
               " > """ + ВремФайл + """ 2>&1";
    
    Запись = Новый ЗаписьТекста(BatФайл, КодировкаТекста.UTF8);
    Запись.Записать(ТекстBat);
    Запись.Закрыть();
    
    ЗапуститьПриложение(BatФайл, Папка, Истина, 60000);
    
    Если ФайлСуществует(ВремФайл) Тогда
        Чтение = Новый ЧтениеТекста(ВремФайл, КодировкаТекста.UTF8);
        Результат = Чтение.Прочитать();
        Чтение.Закрыть();
    Иначе
        Результат = "";
    КонецЕсли;
    
    УдалитьФайлы(ВремФайл);
    УдалитьФайлы(BatФайл);
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция НормализоватьАвтора(Автор)
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("полуночный джун", "Илья Иванов");
    // Добавляйте сюда другие обнаруженные алиасы:
    // Соответствие.Вставить("другой_ник", "Илья Иванов");
    
    Найдено = Соответствие.Получить(Автор);
    Если Найдено <> Неопределено Тогда
        Возврат Найдено;
    КонецЕсли;
    
    Возврат Автор;
КонецФункции

&НаСервере
Функция РаспарситьДату(СтрДата)
    Попытка
        Поз = СтрНайти(СтрДата, "+");
        Если Поз > 0 Тогда
            СтрДата = Лев(СтрДата, Поз - 1);
        КонецЕсли;
        
        СтрДата = СтрЗаменить(СтрДата, "T", " ");
        
        Г = Число(Лев(СтрДата, 4));
        М = Число(Сред(СтрДата, 6, 2));
        Д = Число(Сред(СтрДата, 9, 2));
        Ч = Число(Сред(СтрДата, 12, 2));
        Мин = Число(Сред(СтрДата, 15, 2));
        Сек = Число(Сред(СтрДата, 18, 2));
        
        Возврат Дата(Г, М, Д, Ч, Мин, Сек);
    Исключение
        Возврат ТекущаяДата();
    КонецПопытки;
КонецФункции